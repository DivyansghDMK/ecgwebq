# Copy to .env and fill in values. Never put secrets, tokens or AWS keys in VITE_ variables:
# everything prefixed VITE_ is bundled into the public JavaScript.

# --- API bases ---
VITE_API_BASE_URL=
VITE_ADMIN_AUTH_BASE_URL=
VITE_ADMIN_PROTECTED_API_BASE_URL=
VITE_DOCTOR_API_BASE_URL=
VITE_ADMIN_NEW_API_BASE_URL=

# --- Admin routes ---
VITE_ADMIN_LOGIN_PATH=
VITE_ADMIN_UPLOAD_PATH=
VITE_ADMIN_REPORT_PATH=
VITE_ADMIN_REPORTS_PATH=
VITE_ADMIN_S3_FILES_PATH=
VITE_ADMIN_S3_FILE_CONTENT_PATH=
VITE_CREATE_DOCTOR_PATH=
VITE_ADMIN_GET_DOCTORS_PATH=

# --- Doctor routes ---
VITE_DOCTOR_LOGIN_PATH=
VITE_DOCTOR_REPORTS_PATH=
VITE_DOCTOR_VALIDATE_INVITE_PATH=
VITE_DOCTOR_SET_PASSWORD_PATH=
VITE_DOCTOR_UPLOAD_REVIEWED_PATH=

# --- Support ---
VITE_SUPPORT_API_BASE_URL=
VITE_SUPPORT_COMPLAINTS_PATH=
VITE_SUPPORT_COMPLAINT_PATH=
VITE_SUPPORT_UPDATE_COMPLAINT_PATH=

# --- Release downloads ---
# Base URL of the installer CDN (https). Download links must be on this host.
# latest.json is fetched same-origin via /releases-cdn (Vite proxy / vercel.json rewrite).
VITE_RELEASES_CDN_BASE=
# Internal release/upload history API (admin Releases page).
VITE_RELEASE_API_BASE=
# "true" (default) uses built-in mock data; set "false" to call VITE_RELEASE_API_BASE.
VITE_USE_MOCK_RELEASE_API=
